# Configuración propia de cada desarrollador (contraseña de MySQL, URL base).
/config/config.local.php

# CSV exportados de la planilla: la fuente de verdad es la planilla.
/database/seeds/csv/

# Archivos subidos por los usuarios: datos personales, nunca al repositorio.
# Se versiona solo el .htaccess que bloquea el acceso por URL.
/storage/*
!/storage/.htaccess


# Documentación interna: no va al repositorio final.
/docs/
